<h1 class="page-title">Activity</h1>
<p class="page-subtitle">Every card and list change on the board, most recent first.</p>

<% if @entries.empty? %>
  <div class="empty-state">
    <p>No activity yet.</p>
  </div>
<% else %>
  <ul class="activity-list">
    <% @entries.each do |entry| %>
      <li class="activity-item">
        <span class="activity-dot" aria-hidden="true"></span>
        <div>
          <p class="activity-text"><%= activity_text(entry) %></p>
          <p class="activity-time"><%= format_relative(entry[:createdAt]) %></p>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
