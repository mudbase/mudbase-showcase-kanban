<div style="max-width:32rem;">
  <h1 class="page-title"><%= h(@form_title) %></h1>

  <form action="<%= h(@form_action) %>" method="post" class="stack" novalidate>
    <% if @list %>
      <input type="hidden" name="list_id" value="<%= h(@list[:_id]) %>">
    <% end %>
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" maxlength="120" value="<%= h(@card[:title]) %>" required>
      <span class="field-hint">Up to 120 characters.</span>
    </div>
    <div class="field">
      <label for="description">Description (optional)</label>
      <textarea id="description" name="description" rows="4" maxlength="2000"><%= h(@card[:description]) %></textarea>
    </div>
    <div class="field">
      <label for="assignee_name">Assignee (optional)</label>
      <input type="text" id="assignee_name" name="assignee_name" value="<%= h(@card[:assignee_name]) %>" placeholder="e.g. Mia Member">
      <span class="field-hint">Free-typed display name - there's no user directory to pick from (see plan/build-plan.md).</span>
    </div>
    <div style="display:flex; gap:0.75rem;">
      <button type="submit" class="btn">Save card</button>
      <a href="/" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>
