# ── Mudbase project (public — a project/collection/document ID is not a secret) ────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
LISTS_COLLECTION_ID=
CARDS_COLLECTION_ID=
ACTIVITY_COLLECTION_ID=
# The single shared board's document id (from the small `boards` collection) - see
# plan/build-plan.md for why this must be a real 24-hex-char ObjectId, not a slug.
BOARD_ID=

# ── Session ──────────────────────────────────────────────────────────────
# Rack::Session::Cookie holds every Mudbase-issued JWT server-side, inside an httponly,
# signed+encrypted cookie — client JS never touches it. Generate a long random value, e.g.:
# ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4567
RACK_ENV=development
