# Mudbase Showcase — Kanban (Java / Spring Boot edition) - environment configuration
#
# This app reads configuration from real OS environment variables (see
# src/main/resources/application.properties for the property <-> env var mapping), not from a
# .env file directly - Spring Boot has no built-in .env loader. Export these before running, e.g.:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# or pass them via `-D...` / your process manager / container platform of choice.

# --- Mudbase project (required) ------------------------------------------------
# The project ID from the Mudbase dashboard. Public - not a secret.
MUDBASE_PROJECT_ID=6a6d29b2d07caabbbdfc3f8c

# The three collections this app reads/writes, already provisioned with the field/permission
# shapes documented in ../web/plan/build-plan.md (lists, cards, activity). The `owner` role has
# full CRUD on all three; `member` has full CRUD on cards/activity but read-only on lists;
# `viewer` has read-only on all three.
MUDBASE_LISTS_COLLECTION_ID=6a6d29cad07caabbbdfc3f9a
MUDBASE_CARDS_COLLECTION_ID=6a6d29cad07caabbbdfc3fad
MUDBASE_ACTIVITY_COLLECTION_ID=6a6d29cbd07caabbbdfc3fc6

# Single shared board id - this is a single-board demo, not multi-tenant. Every boardId field on
# every lists/cards/activity document is this constant string. Must be a real 24-hex-char
# ObjectId (verified live - Mudbase's query sanitizer rejects a plain slug like "main-board" as
# an invalid ObjectId reference). This is the id of the single document in the `boards`
# collection (6a6d405cd07caabbbdfc5c79) provisioned for this showcase - see
# ../web/plan/build-plan.md. Not a secret.
MUDBASE_BOARD_ID=6a6d4072d07caabbbdfc5d3c

# Mudbase API base URL. Only override for a self-hosted/staging Mudbase instance.
MUDBASE_URL=https://cloud.mudbase.dev

# --- This app's own deployment ------------------------------------------------
# The port Spring Boot listens on.
PORT=8080

# Disable Thymeleaf template caching during local development so edits show up without a restart.
THYMELEAF_CACHE=false
