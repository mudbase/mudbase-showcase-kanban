# ── Mudbase project (all required — see README "Setup") ────────────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_LISTS_COLLECTION_ID=
MUDBASE_CARDS_COLLECTION_ID=
MUDBASE_ACTIVITY_COLLECTION_ID=

# Single shared board id — this is a single-board demo, not multi-tenant. Every boardId field on
# every lists/cards/activity document is this constant string. Must be a real 24-hex-char
# ObjectId — the platform's query sanitizer validates any field named "...Id" as a real ObjectId
# reference and rejects a plain slug like "main-board". This is the id of the single document in
# the `boards` collection, provisioned read-to-all/write-to-owner-only for this app.
MUDBASE_BOARD_ID=

# ── Session ──────────────────────────────────────────────────────────────────
# Name of the native PHP session cookie. Change only if it collides with another
# app on the same host/port during local development.
SESSION_NAME=mudbase_showcase_kanban_php
