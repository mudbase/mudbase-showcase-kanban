{
    "name": "mudbase/showcase-kanban-php",
    "description": "Mudbase Kanban — PHP reimplementation of the Mudbase showcase team task board. Plain PHP, no framework, backed entirely by the real Mudbase PHP SDK.",
    "type": "project",
    "license": "unlicense",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "mudbase/sdk": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../mudbase-sdk/php"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
