# ── Mudbase project (public — a project/collection ID is not a secret) ─────
NEXT_PUBLIC_MUDBASE_PROJECT_ID=6a6d29b2d07caabbbdfc3f8c
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
# Project-level publishable key (pk_ prefix). Safe to expose client-side — kept here for parity
# with the platform's dashboard and forward-compatibility, but every request in this app
# authenticates with a JWT instead (there is no anonymous/guest session in this app — every
# role, including viewer, must sign in — see src/lib/mudbase.ts and plan/build-plan.md).
NEXT_PUBLIC_MUDBASE_API_KEY=pk_378175f496ff74674413648294b8be69
NEXT_PUBLIC_LISTS_COLLECTION_ID=6a6d29cad07caabbbdfc3f9a
NEXT_PUBLIC_CARDS_COLLECTION_ID=6a6d29cad07caabbbdfc3fad
NEXT_PUBLIC_ACTIVITY_COLLECTION_ID=6a6d29cbd07caabbbdfc3fc6
# Single shared board id — this is a single-board demo, not multi-tenant. Every boardId field on
# every lists/cards/activity document is this constant string. Must be a real 24-hex-char
# ObjectId — verified live that boardId (and cards.assigneeId) are validated by the platform's
# query sanitizer as ObjectId references (a plain slug like "main-board" is rejected
# server-side). This is the id of the single document in the `boards` collection
# (6a6d405cd07caabbbdfc5c79), provisioned read-only-to-all/write-to-owner for this app.
NEXT_PUBLIC_BOARD_ID=6a6d4072d07caabbbdfc5d3c
