# ── Mudbase project (public — a project/collection ID is not a secret) ─────
# Every value below is read client-side via EXPO_PUBLIC_* (Expo's convention
# for env vars that are safe to bundle into the app binary). Every request
# this app makes authenticates with a JWT from a real, signed-in account —
# there is no anonymous/guest session in this app (every role, including
# viewer, must sign in) and no server-only secret anywhere, so nothing needs
# to live outside EXPO_PUBLIC_*.
EXPO_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
EXPO_PUBLIC_MUDBASE_PROJECT_ID=
EXPO_PUBLIC_LISTS_COLLECTION_ID=
EXPO_PUBLIC_CARDS_COLLECTION_ID=
EXPO_PUBLIC_ACTIVITY_COLLECTION_ID=
# Single shared board id — this is a single-board demo, not multi-tenant. Must be a real
# 24-hex-char ObjectId (the platform's query sanitizer validates any *Id field as an ObjectId
# reference) — see plan/build-plan.md for why this can't be an arbitrary slug like "main-board".
EXPO_PUBLIC_BOARD_ID=
