# ── Mudbase project (see plan/build-plan.md for the full collection/permission schema) ──
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d29b2d07caabbbdfc3f8c
MUDBASE_LISTS_COLLECTION_ID=6a6d29cad07caabbbdfc3f9a
MUDBASE_CARDS_COLLECTION_ID=6a6d29cad07caabbbdfc3fad
MUDBASE_ACTIVITY_COLLECTION_ID=6a6d29cbd07caabbbdfc3fc6

# Single shared board - every list/card/activity row's `boardId` field is this one constant. Must
# be a real 24-hex-char ObjectId (Mudbase's query sanitizer validates any field named `...Id` as an
# ObjectId reference) - this is the id of the one document in the `boards` collection
# (6a6d405cd07caabbbdfc5c79), not an arbitrary hex string. See plan/build-plan.md.
MUDBASE_BOARD_ID=6a6d4072d07caabbbdfc5d3c

# ── App/session config ───────────────────────────────────────────────────────
# Signs and encrypts the httpOnly session cookie holding the Mudbase JWT. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to "true" once this app is served over HTTPS in production - a Secure cookie is silently
# never sent over plain HTTP, which would break every page on local development.
COOKIE_SECURE=false

# Local HTTP listen port.
PORT=8080
