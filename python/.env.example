# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference ../web app in this repo —
# see ../web/plan/build-plan.md for the collection/permission schema (local
# auth, Multi-Role with owner/member/viewer, three collections below, each
# granted per the RBAC matrix — read to all three roles, write per role).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d29b2d07caabbbdfc3f8c
LISTS_COLLECTION_ID=6a6d29cad07caabbbdfc3f9a
CARDS_COLLECTION_ID=6a6d29cad07caabbbdfc3fad
ACTIVITY_COLLECTION_ID=6a6d29cbd07caabbbdfc3fc6

# Single shared board id — this is a single-board demo, not multi-tenant. Every boardId field on
# every lists/cards/activity document is this constant string. Must be a real 24-hex-char
# ObjectId — Mudbase's query sanitizer validates any field whose name ends in "Id" as an
# ObjectId reference (a plain slug like "main-board" is rejected server-side). This is the id of
# the single document in the `boards` collection (6a6d405cd07caabbbdfc5c79), provisioned
# read-only-to-all/write-to-owner for this app — see ../web/plan/build-plan.md.
BOARD_ID=6a6d4072d07caabbbdfc5d3c

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_kanban_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# ── Demo accounts (quick sign-in buttons on /login) ─────────────────────────
# The three already-verified owner/member/viewer accounts documented in
# plan/build-plan.md. Not a production secret — this whole app is a public,
# single-shared-board showcase and these credentials are already published
# in this project's own README/build-plan. Override for a private deployment.
DEMO_OWNER_EMAIL=kanban.owner.demo@gmail.com
DEMO_MEMBER_EMAIL=kanban.member.demo@gmail.com
DEMO_VIEWER_EMAIL=kanban.viewer.demo@gmail.com
DEMO_PASSWORD=KanbanTest123!
